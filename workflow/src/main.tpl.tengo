wf := import("@platforma-sdk/workflow-tengo:workflow")
assets:= import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
maps := import("@platforma-sdk/workflow-tengo:maps")

pfTopTableConv := import(":pf-top-table-conv")
pfDeErrorsConv := import(":pf-de-errors-conv")
pfDEGConv := import(":pf-DEG-conv")

runWilcoxonTpl := assets.importTemplate(":runWilcoxon")

wf.prepare(func(args){
	
	metaRefs := {}

	i := 0
	for metaRef in args.covariateRefs {
		metaRefs["metaRef" + i ] = wf.resolve(metaRef, { errIfMissing: true })
		i = i + 1
	}

	return {
		resolvedInput: wf.resolve(args.countsRef, { errIfMissing: true }),
		resolvedContrastFactor: wf.resolve(args.contrastFactor),
		metaRefs: metaRefs 
	}
})

wf.body(func(args) {

	blockId := wf.blockId().getDataAsJson()
	rawCounts := args.resolvedInput
	inputSpec := rawCounts.spec
	species := inputSpec.domain["pl7.app/species"]

	contrastFactor := args.resolvedContrastFactor
	contrastFactorName := contrastFactor.spec.annotations["pl7.app/label"]
	numerators := args.numerators
	denominator := args.denominator
	pAdjThreshold := args.pAdjThreshold
	log2FCThreshold := args.log2FCThreshold

	// Default conversion memory and CPU for the covariates export and the result
	// imports: those carry one row per cell or per gene, orders of magnitude
	// smaller than the counts matrix.
	defaultConvMem := "16GiB"
	defaultConvCpu := 1

	// The counts export is the heaviest conversion in the block: the long-format
	// counts p-column holds one row per non-zero (cell, gene) pair, which reaches
	// hundreds of millions of rows on real datasets. Parquet keeps it columnar,
	// instead of paying CSV text encoding for three high-cardinality string columns.
	countsConvMem := "32GiB" // @TODO: set based on the size of the input
	countsConvCpu := 4       // @TODO: set based on the size of the input

	// Sorted keys, so the covariates frame is the same for the same choice and
	// the export is not recomputed.
	covariates := maps.getValues(args.metaRefs)

	csvCovariates := xsv.exportFrame(covariates, "csv", { mem: defaultConvMem, cpu: defaultConvCpu })
	countsParquet := xsv.exportFrame([rawCounts], "parquet", { mem: countsConvMem, cpu: countsConvCpu })

	runWilcoxonRender := render.create(runWilcoxonTpl, {
		countsParquet: countsParquet,
		csvCovariates: csvCovariates,
		numerators: numerators,
		contrastFactorName: contrastFactorName,
		params: {
			denominator: denominator,
			pAdjThreshold: pAdjThreshold,
			log2FCThreshold: log2FCThreshold
		}
	})

	// Import the result tables as pFrames
	topTableImportParams := pfTopTableConv.getColumns(blockId, species, log2FCThreshold, pAdjThreshold)
	topTablePf := xsv.importFile(runWilcoxonRender.output("topTableParquet"), "parquet", topTableImportParams, { mem: defaultConvMem, cpu: defaultConvCpu })
	topTableFilteredPf := xsv.importFile(runWilcoxonRender.output("topTableFilteredParquet"), "parquet", topTableImportParams, { mem: defaultConvMem, cpu: defaultConvCpu })
	
	deErrorsImportParams := pfDeErrorsConv.getColumns()
	deErrorsPf := xsv.importFile(runWilcoxonRender.output("deErrorsParquet"), "parquet", deErrorsImportParams, { mem: defaultConvMem, cpu: defaultConvCpu })

	DEGImportParams := pfDEGConv.getColumns(blockId, species)
	DEGPf := xsv.importFile(runWilcoxonRender.output("topTableFilteredParquet"), "parquet", DEGImportParams, { mem: defaultConvMem, cpu: defaultConvCpu })

	// Create trace
	pAdjStr := string(pAdjThreshold)
	log2FCStr := string(log2FCThreshold)
	traceLabel := "DEG - Denominator: " + denominator + " (log2FC: " + log2FCStr + ", pAdj: " + pAdjStr + ")"
	trace := pSpec.makeTrace(inputSpec, { type: "milaboratories.sc-differential-expression", importance: 70, label: traceLabel })

	// Build exports with trace injection
	exports := {
		log2foldchange: {
			spec: trace.inject(DEGPf["log2foldchange.spec"]),
			data: DEGPf["log2foldchange.data"]
		},
		regulationDirection: {
			spec: trace.inject(DEGPf["regulationDirection.spec"]),
			data: DEGPf["regulationDirection.data"]
		}
	}
	
	return {
		outputs: {
			topTablePf: pframes.exportFrame(topTablePf),
			topTableFilteredPf: pframes.exportFrame(topTableFilteredPf),
			deErrors: pframes.exportFrame(deErrorsPf)
		},
		exports: exports
	}
})

